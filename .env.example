# Workshop Environment Configuration
# Copy to .env and adjust as needed: cp .env.example .env

# Server port (dev default: 3001, prod default: 3002 via scripts/workshop.sh)
# PORT=3001

# SQLite database path (dev default: ./workshop.db, prod: ~/.workshop/workshop.db)
# WORKSHOP_DB_PATH=./workshop.db

# Workshop API URL — used by MCP server and permission hooks
# WORKSHOP_API_URL=http://localhost:3002

# Obsidian vault root for persistent track memory
# WORKSHOP_VAULT_ROOT=$HOME/projects/WorkflowDocs

# Set to "production" for production mode (serves static files from dist/client/)
# NODE_ENV=production
