<?xml version="1.0"?>
<!--
  Unraid Community Applications template for Workshop's Design Mode
  screenshot sidecar. Optional — only needed if you want element
  screenshots when picking elements in Design Mode.

  Not published to a public registry; build it first, tagging it
  `workshop-playwright:latest`:

      docker build -t workshop-playwright:latest \
        https://github.com/devbdavis/workshop.git#main:docker/playwright

  Then add this template via the Docker tab → "Add Container" → Template, or
  drop this file in /boot/config/plugins/dockerMan/templates-user/.
-->
<Container version="2">
  <Name>workshop-playwright</Name>
  <Repository>workshop-playwright:latest</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project>https://github.com/devbdavis/workshop</Project>
  <Overview>
    Optional screenshot sidecar for Workshop's Design Mode. Runs a headless
    Chromium (Playwright) that loads pages through Workshop's preview port
    and screenshots a picked element. Point it at your Workshop container's
    preview port via WORKSHOP_PREVIEW_URL, then set WORKSHOP_SCREENSHOT_URL
    on the Workshop container to this container's address.
  </Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI/>
  <Icon>https://raw.githubusercontent.com/devbdavis/workshop/main/public/favicon.png</Icon>
  <ExtraParams>--init --shm-size=1g</ExtraParams>
  <DonateText/>
  <DonateLink/>

  <Config Name="Port" Target="3100" Default="3100" Mode="tcp"
          Description="Screenshot sidecar HTTP port" Type="Port"
          Display="always" Required="true" Mask="false">3100</Config>

  <Config Name="WORKSHOP_PREVIEW_URL" Target="WORKSHOP_PREVIEW_URL"
          Default="http://&lt;unraid-ip&gt;:3102" Mode=""
          Description="Workshop's preview port, reachable from this container (e.g. http://&lt;unraid-ip&gt;:3102)"
          Type="Variable" Display="always" Required="true" Mask="false">http://&lt;unraid-ip&gt;:3102</Config>
</Container>
